# Every setting Financial Books reads. Copy to .env (or better: run `node scripts/setup-env.js`, which fills in the
# required ones with new secrets for you). Never commit .env. Blank or missing = the default described.

# --- Basics -------------------------------------------------------------------------------------------------------
# "development" on your computer; "production" on a hosted copy (then APP_BASE_URL must be https:// and DEV_NO_AUTH is refused).
NODE_ENV=development
# Port the app listens on (default 3000).
PORT=3000
# Address to listen on (default 127.0.0.1 in development, 0.0.0.0 in production).
HOST=

# --- Database -----------------------------------------------------------------------------------------------------
# Postgres address the app runs as. Use a normal (non-superuser) role — the app refuses the "postgres" user.
DATABASE_URL=postgres://books_app:CHANGE_ME@127.0.0.1:5432/books
# Set to 1 only to let the app connect as the postgres superuser (tests and throwaway experiments; not recommended).
ALLOW_SUPERUSER=
# Most database connections the app opens at once (default 10).
DB_POOL_MAX=

# --- Your books ---------------------------------------------------------------------------------------------------
# Short name of the books (organization) this app opens: lowercase letters, digits and _. The sample data uses "sample".
APP_ORG=mybooks
# Your name as the owner, shown in the audit log (default "operator").
APP_OPERATOR_NAME=
# BOOKS_MODE: unset (or "live") for normal books. "practice" = a practice copy kept alongside another system: no emails,
# texts, payments or automatic jobs; bank items are only suggested. Anything else stops the app on purpose.
BOOKS_MODE=
# DEMO_MODE: unset (or 0) for normal books. 1 = a public demo of the sample books that anyone can open without signing
# in, wiped and rebuilt every night by `npm run demo-reset` (see README, "Host a public demo"). It runs only on a database
# that demo-reset made, and refuses to start with SETTINGS_KEY, the owner sign-in, bank feeds, BOOKS_MODE or another
# APP_ORG set. Anything else stops the app on purpose.
DEMO_MODE=

# --- Sign-in and secrets ------------------------------------------------------------------------------------------
# 32 random bytes as 64 hex characters (or base64). Encrypts passwords and keys saved in Settings. Back it up: if it's
# lost, saved Settings secrets can't be read. Create one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_KEY=
# Owner sign-in: the bcrypt hash of your password (never the password itself) ...
APP_LOGIN_PASSWORD_HASH=
# ... plus a base32 authenticator (TOTP) secret. setup-env.js makes both and shows the QR code.
APP_TOTP_SECRET=
# Optional APP_OWNER_USER_ID: the Settings > Users account id that is the owner; leave unset to use only the blank-email owner sign-in.
# The account must already exist in APP_ORG. Uncomment and replace 123 with its positive integer id. Refused in the demo.
# APP_OWNER_USER_ID=123
# 1 = skip sign-in entirely (only for trying things on your own computer; refused when NODE_ENV=production).
DEV_NO_AUTH=
# The public https:// address of a hosted copy (used in emailed links and to mark cookies Secure). Leave empty locally.
APP_BASE_URL=
# 1 = the app sits behind one reverse proxy (most hosts); then the visitor's address comes from X-Forwarded-For.
TRUST_PROXY=

# --- Background work ----------------------------------------------------------------------------------------------
# 0 = don't run the daily jobs (recurring transactions, late fees, reminders, scheduled payments and report emails)
# inside the app. They run hourly by default; `npm run jobs` runs them once by hand.
RUN_JOBS=
# 1 = when no email server is set up, print a line for each email that would have been sent.
MAIL_LOG=
# 1 = allow the "test" online-payment processor in production (it lets anyone "pay" without money moving). Leave empty.
PAYMENTS_TEST_MODE=

# --- Optional: bank feeds (off unless LEDGERLINE_URL is set) — see BANK-FEED-CONTRACT.md ----------------------------
# Read-only Postgres address of your bank-data database (a ledgerline-compatible schema).
LEDGERLINE_URL=
# Your bank-data org id (a uuid): the tenant inside that database whose banks these books may read.
LEDGERLINE_ORG_ID=
# 0 = don't pull bank transactions automatically (every 15 minutes); the Refresh button still works.
BANK_PULLS=

# --- Tools only ---------------------------------------------------------------------------------------------------
# Tests: a Postgres superuser address; each test file makes and drops its own database there.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# `npm run seed`: make the sample books as of this date (YYYY-MM-DD) instead of today.
SEED_AS_OF=
# scripts/check-pages.mjs: path to Chrome.
CHROME=
# scripts/setup-env.js: the sign-in password to use with --yes (otherwise it asks, or generates one).
SETUP_PASSWORD=
